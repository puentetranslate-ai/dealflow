# ── Frontend (Vite) ─────────────────────────────────────────
# Exposed in the client bundle. Safe to share.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Server-only (Vercel env vars) ───────────────────────────
# Set these in the Vercel project dashboard, NOT in this file:
#   Vercel → Project → Settings → Environment Variables
# They are read by serverless functions in /api/* and are never
# bundled into the frontend.
#
# RESEND_API_KEY      — required for the Showing Blast feature.
#                       Sign up at https://resend.com, create an API key.
# RESEND_FROM_EMAIL   — optional. Defaults to "DealFlow <onboarding@resend.dev>"
#                       which only sends to your verified Resend account
#                       email. For production, verify a domain at Resend
#                       and set this to e.g. noreply@dealflownow.net.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=DealFlow <noreply@yourdomain.com>
